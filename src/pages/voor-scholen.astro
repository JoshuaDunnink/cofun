---
import BaseLayout from '../layouts/BaseLayout.astro';
import SchoolsPage from '../components/pages/SchoolsPage.astro';
import { useTranslations } from '../i18n/translations';

const locale = 'nl';
const t = useTranslations(locale);
---

<BaseLayout
  title={t('nav.schools')}
  description={t('hero.schools.subtitle')}
  locale={locale}
  image="/images/redesign/classroom.png"
>
  <SchoolsPage locale={locale} />
</BaseLayout>
