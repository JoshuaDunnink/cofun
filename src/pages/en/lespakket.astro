---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CurriculumPage from '../../components/pages/CurriculumPage.astro';
import { useTranslations } from '../../i18n/translations';

const locale = 'en';
const t = useTranslations(locale);
---

<BaseLayout
  title={t('nav.curriculum')}
  description={t('hero.curriculum.subtitle')}
  locale={locale}
  image="/images/redesign/workspace.png"
>
  <CurriculumPage locale={locale} />
</BaseLayout>
