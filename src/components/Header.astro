---
import { useTranslations, getNavItems, getLocalePath } from '../i18n/translations';
import type { Locale } from '../i18n/translations';

interface Props {
  locale?: Locale;
}

const { locale = 'nl' } = Astro.props;
const t = useTranslations(locale);
const navItems = getNavItems(locale);

const rawPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
  const h = href.replace(/\/+$/, '') || '/';
  return h === rawPath;
};

/* Language switch: toggle the /en prefix while keeping the current page */
const switchLabel = t('lang.switch');
const switchPath =
  locale === 'nl'
    ? `/en${rawPath === '/' ? '' : rawPath}`
    : rawPath.replace(/^\/en/, '') || '/';
---

<header class="sticky top-0 z-50 w-full bg-surface/95 backdrop-blur shadow-sm">
  <nav
    class="mx-auto flex h-20 max-w-container-max items-center justify-between px-margin-mobile md:px-margin-desktop"
    aria-label={t('nav.menu')}
  >
    <a href={getLocalePath(locale, '/')} class="flex items-center gap-2" aria-label="CoFun home">
      <img
        src="/images/logo-cofun-primary.png"
        alt="CoFun"
        width="140"
        height="40"
        class="h-9 w-auto object-contain"
      />
    </a>

    <!-- Desktop nav -->
    <div class="hidden items-center gap-8 md:flex">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'font-label-sm text-label-sm transition-colors',
              isActive(item.href)
                ? 'border-b-2 border-secondary-fixed-dim pb-0.5 font-bold text-primary'
                : 'text-on-surface-variant hover:text-primary',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={switchPath}
        class="inline-flex items-center justify-center rounded-full border-2 border-primary px-3 py-1 font-label-sm text-label-sm text-primary transition-colors hover:bg-primary hover:text-on-primary"
        aria-label={t('lang.switch.label')}
      >
        {switchLabel}
      </a>
    </div>

    <!-- Mobile toggle -->
    <button
      id="menu-toggle"
      class="flex items-center justify-center rounded-lg p-2 text-on-surface-variant md:hidden"
      aria-label={t('nav.menu')}
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <span class="material-symbols-outlined" aria-hidden="true">menu</span>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden border-t border-outline-variant/40 bg-surface px-margin-mobile pb-6 pt-2 md:hidden"
  >
    <div class="flex flex-col gap-1">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-lg px-3 py-3 font-label-sm transition-colors',
              isActive(item.href)
                ? 'bg-primary/10 font-bold text-primary'
                : 'text-on-surface-variant hover:bg-surface-container',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={switchPath}
        class="mt-2 inline-flex w-fit items-center justify-center rounded-full border-2 border-primary px-4 py-1.5 font-label-sm text-primary"
        aria-label={t('lang.switch.label')}
      >
        {switchLabel}
      </a>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('menu-toggle');
    var menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;
    btn.addEventListener('click', function () {
      var open = menu.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', String(open));
      var icon = btn.querySelector('.material-symbols-outlined');
      if (icon) icon.textContent = open ? 'close' : 'menu';
    });
  })();
</script>
