---
import { useTranslations, getNavItems, getLocalePath, withBase } from '../i18n/translations';
import type { Locale } from '../i18n/translations';

interface Props {
  locale?: Locale;
}

const { locale = 'nl' } = Astro.props;
const t = useTranslations(locale);
const basePath = Astro.site?.pathname ?? '/';
const navItems = getNavItems(locale, basePath);
const email = t('footer.email');
---

<footer class="w-full bg-surface-container-highest pt-section-gap">
  <div
    class="mx-auto mb-16 grid max-w-container-max grid-cols-1 gap-gutter px-margin-mobile md:grid-cols-4 md:px-margin-desktop"
  >
    <div class="space-y-4">
      <a href={getLocalePath(locale, '/', basePath)} aria-label="CoFun home">
        <img
          src={withBase('/images/logo-cofun-primary.png', basePath)}
          alt="CoFun"
          width="140"
          height="40"
          class="h-9 w-auto object-contain"
        />
      </a>
      <p class="max-w-xs font-body-md text-on-surface-variant">{t('footer.tagline')}</p>
      <a
        href={`mailto:${email}`}
        class="inline-flex items-center gap-2 text-primary transition-colors hover:text-secondary"
      >
        <span class="material-symbols-outlined" aria-hidden="true">alternate_email</span>
        <span class="font-label-sm">{email}</span>
      </a>
    </div>

    <div class="space-y-4">
      <h2 class="font-heading text-base font-bold text-on-surface">{t('footer.nav')}</h2>
      <ul class="space-y-2">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-on-surface-variant transition-colors hover:text-secondary"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="space-y-4">
      <h2 class="font-heading text-base font-bold text-on-surface">{t('footer.contact')}</h2>
      <p>
        <a
          href={`mailto:${email}`}
          class="text-on-surface-variant transition-colors hover:text-secondary"
        >
          {email}
        </a>
      </p>
      <div
        class="flex items-start gap-3 rounded-xl border border-outline-variant/30 bg-white/50 p-4"
      >
        <span class="material-symbols-outlined text-secondary" aria-hidden="true">construction</span>
        <p class="text-xs text-on-surface-variant">{t('footer.construction')}</p>
      </div>
    </div>

    <div class="space-y-4">
      <h2 class="font-heading text-base font-bold text-on-surface">{t('footer.legal')}</h2>
      <ul class="space-y-2">
        <li>
          <span class="text-on-surface-variant/70">{t('footer.privacy')}</span>
        </li>
        <li>
          <span class="text-on-surface-variant/70">{t('footer.terms')}</span>
        </li>
      </ul>
    </div>
  </div>

  <div
    class="mx-auto max-w-container-max border-t border-outline-variant/20 px-margin-mobile py-6 text-center md:px-margin-desktop"
  >
    <p class="font-label-sm text-on-surface-variant">{t('footer.copyright')}</p>
  </div>
</footer>
