---
interface Props {
  title: string;
  text?: string;
  bg?: 'primary' | 'primary-container';
}

const { title, text, bg = 'primary' } = Astro.props;
const bgCls = bg === 'primary' ? 'bg-primary' : 'bg-primary-container';
---

<section class="py-section-gap">
  <div class="mx-auto max-w-container-max px-margin-mobile md:px-margin-desktop">
    <div
      class:list={[
        'relative overflow-hidden rounded-[2.5rem] p-12 text-center shadow-2xl md:p-20 reveal',
        bgCls,
      ]}
    >
      <div
        class="pointer-events-none absolute left-0 top-0 h-48 w-48 -translate-x-1/2 -translate-y-1/2 rounded-full bg-white/5"
      >
      </div>
      <div
        class="pointer-events-none absolute bottom-0 right-0 h-72 w-72 translate-x-1/3 translate-y-1/3 rounded-full bg-white/5"
      >
      </div>
      <div class="relative z-10 mx-auto max-w-2xl space-y-8">
        <h2 class="font-heading text-3xl font-bold text-white md:text-display-lg">{title}</h2>
        {text && <p class="font-body-lg text-body-lg leading-relaxed text-primary-fixed">{text}</p>}
        <div class="flex flex-col justify-center gap-4 sm:flex-row">
          <slot />
        </div>
      </div>
    </div>
  </div>
</section>
