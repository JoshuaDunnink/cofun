---
import { useTranslations } from '../../i18n/translations';
import type { Locale } from '../../i18n/translations';
import PageHero from '../ui/PageHero.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const email = t('footer.email');

const faqs = [
  { q: t('contact.faq.q1'), a: t('contact.faq.a1') },
  { q: t('contact.faq.q2'), a: t('contact.faq.a2') },
];
---

<PageHero
  image="/images/redesign/workspace.png"
  title={t('contact.hero.title')}
  subtitle={t('contact.hero.subtitle')}
  overlay="light-bottom"
  titleColor="primary"
/>

<!-- Contact (email-first, no form) -->
<section class="py-section-gap">
  <div class="mx-auto max-w-container-max px-margin-mobile md:px-margin-desktop">
    <div class="grid grid-cols-1 gap-gutter lg:grid-cols-12">
      <!-- Primary email CTA -->
      <div class="rounded-2xl border border-outline-variant bg-white p-8 shadow-sm md:p-12 lg:col-span-7 reveal">
        <h2 class="mb-4 font-heading text-headline-md font-semibold text-primary">{t('contact.intro.title')}</h2>
        <p class="mb-8 max-w-xl font-body-lg text-body-lg text-on-surface-variant">{t('contact.intro.text')}</p>

        <div class="flex flex-col items-start gap-6 rounded-2xl bg-surface-container-low p-8 sm:flex-row sm:items-center">
          <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
            <span class="material-symbols-outlined text-3xl" aria-hidden="true">mail</span>
          </div>
          <div class="flex-1">
            <p class="font-label-sm text-on-surface-variant">{t('contact.email.label')}</p>
            <a
              href={`mailto:${email}`}
              class="font-heading text-2xl font-bold text-on-surface transition-colors hover:text-primary"
            >
              {email}
            </a>
          </div>
          <a
            href={`mailto:${email}`}
            class="inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-8 py-4 font-label-sm text-on-primary shadow-md transition-all hover:-translate-y-0.5 hover:bg-primary-container"
          >
            {t('contact.email.cta')}
            <span class="material-symbols-outlined text-[20px]" aria-hidden="true">send</span>
          </a>
        </div>
        <p class="mt-4 font-label-sm text-on-surface-variant">{t('contact.email.note')}</p>
      </div>

      <!-- FAQ sidebar -->
      <div class="flex flex-col gap-gutter lg:col-span-5">
        <div class="rounded-2xl border border-outline-variant border-t-4 border-t-secondary-container bg-surface-container-low p-8 reveal">
          <h3 class="mb-6 font-heading text-headline-md font-semibold text-primary">{t('contact.faq.title')}</h3>
          <div class="space-y-5">
            {
              faqs.map((f, i) => (
                <div>
                  {i > 0 && <div class="mb-5 h-px bg-outline-variant/30" />}
                  <p class="flex items-center gap-2 font-label-sm font-bold text-primary">
                    <span class="material-symbols-outlined text-[18px]" aria-hidden="true">help</span>
                    {f.q}
                  </p>
                  <p class="mt-1 font-body-md text-on-surface-variant">{f.a}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Closing -->
<section class="bg-surface-container-highest px-margin-mobile py-20 md:px-margin-desktop">
  <div class="mx-auto max-w-container-max text-center reveal">
    <span class="mb-6 inline-block rounded-full bg-secondary-container/30 px-4 py-1.5 font-label-sm text-xs uppercase tracking-widest text-secondary">
      {t('contact.closing.badge')}
    </span>
    <h2 class="mb-6 font-heading text-3xl font-bold text-primary md:text-display-lg md:text-[40px]">
      {t('contact.closing.title')}
    </h2>
    <p class="mx-auto mb-8 max-w-2xl font-body-lg text-body-lg text-on-surface-variant">
      {t('contact.closing.text')}
    </p>
    <p class="flex items-center justify-center gap-2 font-label-sm text-on-surface">
      <span class="material-symbols-outlined filled text-secondary" aria-hidden="true">favorite</span>
      {t('contact.closing.note')}
    </p>
  </div>
</section>
