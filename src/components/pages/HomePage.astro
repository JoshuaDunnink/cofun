---
import { useTranslations, getLocalePath } from '../../i18n/translations';
import type { Locale } from '../../i18n/translations';
import Button from '../ui/Button.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import CTASection from '../ui/CTASection.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const p = (path: string) => getLocalePath(locale, path);

const steps = [
  {
    icon: 'videogame_asset',
    title: t('home.step.play.title'),
    text: t('home.step.play.text'),
    iconWrap: 'bg-secondary-container',
    iconColor: 'text-on-secondary-container',
  },
  {
    icon: 'visibility',
    title: t('home.step.observe.title'),
    text: t('home.step.observe.text'),
    iconWrap: 'bg-tertiary-fixed',
    iconColor: 'text-on-tertiary-fixed-variant',
  },
  {
    icon: 'psychology_alt',
    title: t('home.step.reflect.title'),
    text: t('home.step.reflect.text'),
    iconWrap: 'bg-primary-fixed-dim',
    iconColor: 'text-on-primary-fixed-variant',
  },
];
---

<!-- Hero -->
<section class="relative flex min-h-[85vh] items-center overflow-hidden">
  <div class="absolute inset-0 z-0">
    <img
      src="/images/redesign/classroom.png"
      alt=""
      class="h-full w-full object-cover"
      width="1280"
      height="853"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-on-background/85 via-on-background/55 to-on-background/20"></div>
  </div>
  <div class="relative z-10 mx-auto w-full max-w-container-max px-margin-mobile md:px-margin-desktop">
    <div class="max-w-3xl space-y-6">
      <div
        class="floating-element inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-2 font-label-sm text-white backdrop-blur-sm"
      >
        <span class="material-symbols-outlined filled text-base text-secondary-fixed-dim" aria-hidden="true">stars</span>
        {t('hero.home.badge')}
      </div>
      <h1 class="font-heading text-display-lg-mobile font-extrabold text-white md:text-display-lg md:text-[56px] md:leading-[1.05]">
        {t('hero.home.title')}
      </h1>
      <p class="max-w-xl font-body-lg text-body-lg text-surface-container-low">{t('hero.home.subtitle')}</p>
      <div class="flex flex-col gap-4 pt-4 sm:flex-row">
        <Button href={p('/lespakket')} variant="primary">{t('hero.home.cta')}</Button>
        <Button href="#aanpak" variant="onPrimary">{t('hero.home.cta_secondary')}</Button>
      </div>
    </div>
  </div>
</section>

<!-- Challenge -->
<section class="bg-surface-container-low py-section-gap">
  <div class="mx-auto max-w-container-max px-margin-mobile md:px-margin-desktop">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="group relative overflow-hidden rounded-3xl shadow-2xl reveal">
        <img
          src="/images/redesign/workspace.png"
          alt=""
          class="h-[460px] w-full object-cover transition-transform duration-700 group-hover:scale-105"
          width="640"
          height="460"
        />
        <div class="absolute inset-x-6 bottom-6 rounded-2xl border-l-4 border-error bg-white/90 p-6 backdrop-blur-sm">
          <p class="font-label-sm italic text-on-surface-variant">{t('home.challenge.quote')}</p>
        </div>
      </div>
      <div class="space-y-8 reveal">
        <div class="space-y-3">
          <span class="text-xs font-bold uppercase tracking-widest text-primary">{t('home.challenge.eyebrow')}</span>
          <h2 class="font-heading text-3xl font-bold text-on-background md:text-4xl">{t('home.challenge.title')}</h2>
        </div>
        <p class="font-body-lg text-body-lg leading-relaxed text-on-surface-variant">{t('home.challenge.text1')}</p>
        <div class="rounded-2xl border border-outline-variant bg-white p-8 shadow-sm">
          <p class="text-xl font-bold leading-relaxed text-primary">{t('home.challenge.highlight')}</p>
        </div>
        <p class="font-body-md text-on-surface-variant">{t('home.challenge.text2')}</p>
      </div>
    </div>
  </div>
</section>

<!-- Solution: 3 steps -->
<section id="aanpak" class="overflow-hidden py-section-gap">
  <div class="mx-auto mb-16 max-w-container-max px-margin-mobile md:px-margin-desktop">
    <SectionHeading title={t('home.solution.title')} subtitle={t('home.solution.subtitle')} />
  </div>
  <div class="mx-auto max-w-container-max px-margin-mobile md:px-margin-desktop">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      {
        steps.map((s, i) => (
          <div class="group relative rounded-[2rem] border border-outline-variant bg-white p-10 shadow-sm transition-all hover:border-primary reveal">
            <div class:list={['mb-6 flex h-16 w-16 items-center justify-center rounded-2xl transition-transform group-hover:rotate-6', s.iconWrap]}>
              <span class:list={['material-symbols-outlined filled text-3xl', s.iconColor]} aria-hidden="true">
                {s.icon}
              </span>
            </div>
            <h3 class="mb-4 font-heading text-headline-md font-semibold">{s.title}</h3>
            <p class="font-body-md text-on-surface-variant">{s.text}</p>
            <div class="absolute -right-4 -top-4 flex h-12 w-12 items-center justify-center rounded-full bg-primary font-bold text-white">
              {i + 1}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- Features bento -->
<section class="bg-surface-gray py-section-gap">
  <div class="mx-auto max-w-container-max px-margin-mobile md:px-margin-desktop">
    <div class="mb-16 text-center">
      <SectionHeading title={t('home.features.title')} />
      <p class="mt-4 font-bold text-primary">{t('home.features.subtitle')}</p>
    </div>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-12 md:grid-rows-2 md:[min-height:600px]">
      <!-- Feature 1 -->
      <div class="group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-outline-variant bg-white p-8 shadow-sm md:col-span-7 reveal">
        <div class="relative z-10">
          <span class="material-symbols-outlined filled mb-4 text-4xl text-secondary" aria-hidden="true">extension</span>
          <h3 class="mb-2 font-heading text-headline-md font-semibold">{t('home.feature.play.title')}</h3>
          <p class="max-w-md font-body-md text-on-surface-variant">{t('home.feature.play.text')}</p>
        </div>
        <span
          class="material-symbols-outlined filled pointer-events-none absolute -bottom-6 -right-4 text-[180px] text-primary/10 transition-transform group-hover:scale-110"
          aria-hidden="true">toys</span>
      </div>
      <!-- Feature 2 -->
      <div class="flex flex-col justify-center rounded-3xl bg-primary p-8 text-on-primary shadow-sm md:col-span-5 reveal">
        <span class="material-symbols-outlined mb-4 text-4xl" aria-hidden="true">lightbulb</span>
        <h3 class="mb-2 font-heading text-headline-md font-semibold text-white">{t('home.feature.insight.title')}</h3>
        <p class="font-body-md leading-relaxed text-primary-fixed">{t('home.feature.insight.text')}</p>
      </div>
      <!-- Feature 3 -->
      <div class="flex flex-col justify-end rounded-3xl bg-secondary-container p-8 shadow-sm md:col-span-5 reveal">
        <h3 class="mb-2 font-heading text-headline-md font-semibold text-on-secondary-container">{t('home.feature.growth.title')}</h3>
        <p class="font-body-md text-on-secondary-fixed-variant">{t('home.feature.growth.text')}</p>
        <span class="material-symbols-outlined mt-4 text-4xl text-on-secondary-container" aria-hidden="true">trending_up</span>
      </div>
      <!-- Feature 4 -->
      <div class="group flex items-center gap-8 overflow-hidden rounded-3xl border border-outline-variant bg-white p-8 shadow-sm md:col-span-7 reveal">
        <div class="flex-1">
          <h3 class="mb-2 font-heading text-headline-md font-semibold">{t('home.feature.connection.title')}</h3>
          <p class="font-body-md text-on-surface-variant">{t('home.feature.connection.text')}</p>
        </div>
        <div class="hidden h-32 w-32 shrink-0 items-center justify-center rounded-full bg-surface-container transition-colors group-hover:bg-primary/10 md:flex">
          <span class="material-symbols-outlined text-5xl text-primary" aria-hidden="true">groups</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<CTASection title={t('home.cta.title')} text={t('home.cta.text')}>
  <Button href={p('/contact')} variant="secondary">{t('home.cta.button')}</Button>
</CTASection>
