---
import { useTranslations, getLocalePath } from '../../i18n/translations';
import type { Locale } from '../../i18n/translations';
import Button from '../ui/Button.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import PageHero from '../ui/PageHero.astro';
import CTASection from '../ui/CTASection.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const basePath = Astro.site?.pathname ?? '/';
const p = (path: string) => getLocalePath(locale, path, basePath);

const values = [
  { icon: 'emoji_objects', color: 'text-growth-orange', title: t('about.value.innovation.title'), text: t('about.value.innovation.text') },
  { icon: 'favorite', color: 'text-primary', title: t('about.value.empathy.title'), text: t('about.value.empathy.text') },
  { icon: 'groups', color: 'text-success-mint', title: t('about.value.collaboration.title'), text: t('about.value.collaboration.text') },
];

const roles = [
  { icon: 'school', title: t('about.role.education.title'), text: t('about.role.education.text') },
  { icon: 'neurology', title: t('about.role.pedagogy.title'), text: t('about.role.pedagogy.text') },
  { icon: 'extension', title: t('about.role.play.title'), text: t('about.role.play.text') },
  { icon: 'diversity_3', title: t('about.role.schools.title'), text: t('about.role.schools.text') },
];

const focusPoints = [t('about.focus.point1'), t('about.focus.point2'), t('about.focus.point3')];
---

<PageHero
  image="/images/redesign/team-collaboration.png"
  badge={t('hero.about.badge')}
  title={t('hero.about.title')}
  subtitle={t('hero.about.subtitle')}
  overlay="light-bottom"
  titleColor="primary"
/>

<!-- Mission / Vision / Focus bento -->
<section class="py-section-gap">
  <div class="mx-auto max-w-container-max px-margin-mobile md:px-margin-desktop">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-12">
      <div class="flex flex-col justify-between rounded-[24px] border border-outline-variant/30 bg-surface-container-low p-10 md:col-span-7 reveal">
        <div>
          <div class="mb-8 flex h-12 w-12 items-center justify-center rounded-xl bg-primary text-on-primary">
            <span class="material-symbols-outlined" aria-hidden="true">visibility</span>
          </div>
          <h2 class="mb-4 font-heading text-headline-md font-semibold text-primary">{t('about.vision.title')}</h2>
          <p class="font-body-md leading-relaxed text-on-surface-variant">{t('about.vision.text')}</p>
        </div>
        <div class="mt-8">
          <div class="h-2 w-full overflow-hidden rounded-full bg-surface-container">
            <div class="h-full w-3/4 rounded-full bg-gradient-to-r from-primary to-secondary-container"></div>
          </div>
          <p class="mt-3 font-label-sm italic text-on-surface-variant">{t('about.vision.note')}</p>
        </div>
      </div>

      <div class="flex flex-col justify-center rounded-[24px] border-t-8 border-growth-orange bg-secondary-container p-10 text-on-secondary-container md:col-span-5 reveal">
        <h3 class="mb-4 font-heading text-headline-md font-semibold">{t('about.focus.title')}</h3>
        <p class="mb-6 font-body-md opacity-90">{t('about.focus.text')}</p>
        <ul class="space-y-4">
          {
            focusPoints.map((pt) => (
              <li class="flex items-center gap-3">
                <span class="material-symbols-outlined text-growth-orange" aria-hidden="true">check_circle</span>
                <span class="font-label-sm">{pt}</span>
              </li>
            ))
          }
        </ul>
      </div>

      {
        values.map((v) => (
          <div class="rounded-[24px] border border-outline-variant/20 bg-white p-8 card-shadow md:col-span-4 reveal">
            <div class:list={['mb-4', v.color]}>
              <span class="material-symbols-outlined filled text-4xl" aria-hidden="true">{v.icon}</span>
            </div>
            <h4 class="mb-2 font-heading text-headline-md font-semibold text-primary">{v.title}</h4>
            <p class="font-body-md text-on-surface-variant">{v.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- Mission + approach + why -->
<section class="bg-surface-container-low py-section-gap">
  <div class="mx-auto max-w-container-max space-y-12 px-margin-mobile md:px-margin-desktop">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-2">
      <div class="space-y-4 reveal">
        <h2 class="font-heading text-2xl font-bold text-on-background md:text-3xl">{t('about.mission.title')}</h2>
        <p class="font-body-lg text-body-lg leading-relaxed text-on-surface-variant">{t('about.mission.text')}</p>
      </div>
      <div class="space-y-4 reveal">
        <h2 class="font-heading text-2xl font-bold text-on-background md:text-3xl">{t('about.approach.title')}</h2>
        <p class="prose-cofun font-body-lg text-body-lg leading-relaxed text-on-surface-variant" set:html={t('about.approach.text')} />
      </div>
    </div>
    <div class="rounded-[24px] border border-outline-variant/30 bg-white p-8 shadow-sm md:p-12 reveal">
      <h2 class="mb-4 font-heading text-2xl font-bold text-primary md:text-3xl">{t('about.why.title')}</h2>
      <p class="prose-cofun max-w-4xl font-body-lg text-body-lg leading-relaxed text-on-surface-variant" set:html={t('about.why.text')} />
    </div>
  </div>
</section>

<!-- Expertise ("team") -->
<section class="bg-surface-gray py-section-gap">
  <div class="mx-auto max-w-container-max px-margin-mobile md:px-margin-desktop">
    <div class="mb-16 text-center">
      <SectionHeading
        eyebrow={t('about.team.eyebrow')}
        eyebrowColor="text-growth-orange"
        title={t('about.team.title')}
        subtitle={t('about.team.subtitle')}
      />
    </div>
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        roles.map((r) => (
          <div class="reveal">
            <div class="mb-4 flex h-44 items-center justify-center rounded-[24px] bg-surface-container-high">
              <span class="material-symbols-outlined text-6xl text-primary" aria-hidden="true">{r.icon}</span>
            </div>
            <h3 class="font-heading text-headline-md font-semibold text-primary">{r.title}</h3>
            <p class="font-label-sm text-on-surface-variant">{r.text}</p>
          </div>
        ))
      }
    </div>

    <!-- Team members -->
    <div class="mt-16 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <div class="flex flex-col items-center text-center reveal">
        <div class="relative mb-4 flex h-44 w-full items-center justify-center overflow-hidden rounded-[24px] bg-primary/10">
          <span class="font-heading text-6xl font-bold text-primary">T</span>
        </div>
        <h3 class="font-heading text-headline-md font-semibold text-on-background">Tifene</h3>
        <p class="font-label-sm text-on-surface-variant">{t('about.team.placeholder')}</p>
      </div>
      <div class="flex flex-col items-center text-center reveal">
        <div class="relative mb-4 flex h-44 w-full items-center justify-center overflow-hidden rounded-[24px] bg-primary/10">
          <span class="font-heading text-6xl font-bold text-primary">C</span>
        </div>
        <h3 class="font-heading text-headline-md font-semibold text-on-background">Claudia</h3>
        <p class="font-label-sm text-on-surface-variant">{t('about.team.placeholder')}</p>
      </div>
    </div>
  </div>
</section>

<CTASection title={t('about.cta.title')} text={t('about.cta.text')}>
  <Button href={p('/lespakket')} variant="secondary">{t('cta.curriculum')}</Button>
  <Button href={p('/contact')} variant="onPrimary">{t('cta.contact')}</Button>
</CTASection>
