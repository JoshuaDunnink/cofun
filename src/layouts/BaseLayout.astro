---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { useTranslations } from '../i18n/translations';
import type { Locale } from '../i18n/translations';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'CoFun helpt scholen om leerlingen weer in beweging te krijgen — spelend beter leren door cognitieve en executieve functies te versterken.',
  locale = 'nl',
  image = '/images/redesign/classroom.png',
  noindex = false,
} = Astro.props;

const t = useTranslations(locale);
const htmlLang = locale === 'nl' ? 'nl' : 'en';

const site = Astro.site ?? new URL('https://cofun.nl');

/* Normalise current path (strip trailing slash except root) */
const rawPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const nlPath = locale === 'en' ? rawPath.replace(/^\/en/, '') || '/' : rawPath;
const enPath = locale === 'en' ? rawPath : `/en${rawPath === '/' ? '' : rawPath}`;

const canonical = new URL(rawPath, site).href;
const nlHref = new URL(nlPath, site).href;
const enHref = new URL(enPath, site).href;
const ogImage = new URL(image, site).href;
const fullTitle = `${title} | CoFun`;
---

<!doctype html>
<html lang={htmlLang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/images/logo-cofun-primary.png" />
    <link rel="canonical" href={canonical} />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Language alternates -->
    <link rel="alternate" hreflang="nl" href={nlHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={nlHref} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CoFun" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={locale === 'nl' ? 'nl_NL' : 'en_US'} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#006767" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0..1,0&display=swap"
      rel="stylesheet"
    />

    <!-- Enable JS-only enhancements before paint (avoids reveal flash for no-JS) -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-[100] focus:m-2 focus:rounded-lg focus:bg-primary focus:px-4 focus:py-2 focus:text-on-primary">
      {t('skip.content')}
    </a>
    <Header locale={locale} />
    <main id="main-content">
      <slot />
    </main>
    <Footer locale={locale} />

    <script is:inline>
      // Scroll-reveal: reveal elements with .reveal as they enter the viewport.
      (function () {
        var els = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window) || !els.length) {
          els.forEach(function (el) {
            el.classList.add('is-visible');
          });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );
        els.forEach(function (el) {
          io.observe(el);
        });
      })();
    </script>
  </body>
</html>
