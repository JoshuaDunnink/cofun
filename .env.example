# FTP credentials
FTP_HOST=
FTP_USER=
FTP_PASS=

# Optional override for the remote upload directory.
# Production default: /httpdocs/
# Staging default: /httpdocs/cofun/__development/
FTP_REMOTE_DIR=

# Optional default deployment environment: production or staging
DEPLOY_ENV=production

# Optional site URL override used during Astro build
# Production default: https://cofun.nl
# Staging default: https://cofun.nl/cofun/__development/
SITE_URL=
